# Astra-Trade QML - Training Docker (RunPod GPU)
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0

# System dependencies
RUN apt-get update && apt-get install -y \
    python3.10 python3-pip python3-dev \
    git wget curl vim \
    libgomp1 libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set workdir
WORKDIR /app

# Install Python dependencies
COPY requirements/requirements-training.txt .
RUN pip3 install --no-cache-dir -r requirements-training.txt

# Copy source code
COPY src/ ./src/
COPY config/ ./config/
COPY scripts/ ./scripts/

# Create necessary directories
RUN mkdir -p logs models data checkpoints

# Environment variables for RunPod
ENV RUNPOD_POD_ID=""
ENV AWS_ACCESS_KEY_ID=""
ENV AWS_SECRET_ACCESS_KEY=""
ENV S3_MODEL_BUCKET="astra-trade-models"

# Training entrypoint
CMD ["python3", "-m", "src.main", "--mode", "train"]