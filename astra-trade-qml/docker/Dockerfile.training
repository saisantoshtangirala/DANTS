# Astra-Trade QML - Training Docker (RunPod GPU)
#
# Built FROM RunPod's own pytorch image rather than assembling
# CUDA+Python by hand: this exact base (Python 3.11, CUDA 12.4, matching
# torch/torchvision/torchaudio) is what the project's real GPU smoke test
# was validated against, so building from it avoids re-deriving a
# combination that's already proven to work.
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install Python dependencies (torch/torchvision/torchaudio already
# provided by the base image - see requirements-runpod-image.txt).
COPY requirements/requirements-runpod-image.txt .
RUN pip install --no-cache-dir -r requirements-runpod-image.txt

# Copy source code
COPY src/ ./src/
COPY config/ ./config/
COPY scripts/ ./scripts/

# Create necessary directories
RUN mkdir -p logs models data checkpoints

# Training entrypoint
CMD ["python3", "-m", "src.main", "--mode", "train"]
