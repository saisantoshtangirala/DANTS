# Astra-Trade QML - Paper Trading Docker (Hetzner VPS)
FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System dependencies
RUN apt-get update && apt-get install -y \
    gcc g++ libgomp1 \
    libpq-dev \
    curl cron \
    && rm -rf /var/lib/apt/lists/*

# Set workdir
WORKDIR /app

# Install Python dependencies
COPY requirements/requirements-paper.txt .
RUN pip install --no-cache-dir -r requirements-paper.txt

# Copy source code
COPY src/ ./src/
COPY config/ ./config/
COPY scripts/ ./scripts/

# Create necessary directories
RUN mkdir -p logs models data

# Environment variables for Hetzner + Zerodha
ENV KITE_API_KEY=""
ENV KITE_ACCESS_TOKEN=""
ENV DATABASE_URL="sqlite:///logs/astra_trade.db"
ENV MODEL_SYNC_S3_BUCKET="astra-trade-models"

# Expose dashboard port
EXPOSE 8501

# Paper trading entrypoint
CMD ["python3", "-m", "src.main", "--mode", "paper"]